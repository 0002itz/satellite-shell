---
import Cardlauch from './Cardlauch.astro'
import { db } from "astro:db"
import { Herbs_db, Ceremonis_db } from 'astro:db'

export const herbs = await db.select().from(Herbs_db)
export const ceremonis = await db.select().from(Ceremonis_db)
---
<div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
  {herbs.map((herbs) => <Cardlauch imagePath=`/src/assets/${herbs.name_herbs}.png` herbs_p={herbs} />)}
</div>
gb n
<div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
  {ceremonis.map((ceremonis) => <Cardlauch imagePath=`/src/assets/${ceremonis.name_ceremoni}.png` herbs_p={ceremonis} />)}
</div>